# All price & fundamental data comes from EODHD (same token as Bob the Bot).
EODHD_API_TOKEN=your_eodhd_api_token_here

# Legacy src/ pipeline only (not used by scanner/)
FMP_API_KEY=your_fmp_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email notification (Gmail example — use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_inbox@example.com
